# Proxmox API connection
proxmox_endpoint  = "https://192.168.50.50:8006/"
proxmox_api_token = "root@pam!token_id=replace-me"
proxmox_insecure  = true
# WARNING: proxmox_insecure=true disables TLS verification. Use only for a
# homelab with a self-signed Proxmox certificate.
proxmox_node      = "homelab"

# VM and network
datastore_id  = "local-lvm"
network_bridge = "vmbr0"
ssh_public_key = "ssh-ed25519 AAAA... replace-me"
ip_address     = "192.168.50.55/24"
gateway        = "192.168.50.1"

# k3s
k3s_token   = "replace-with-a-long-random-token"
k3s_version = "v1.36.4+k3s1"

# Optional overrides
# proxmox_insecure = false
# vm_name          = "k3s-node-01"
# vm_id            = 900
# cpu_cores        = 6
# memory_size      = 14336
# disk_size        = 100
# ssh_user         = "ubuntu"
docker_hub_mirror = "https://mirror.gcr.io"
kubeconfig_path   = "./kubeconfig.yaml"
