# ==============================================================================
# Terraform Ignore Patterns
# ==============================================================================
# Local .terraform directory (contains downloaded providers and modules)
**/.terraform/*

# OpenTofu shared provider plugin cache (see Makefile TF_PLUGIN_CACHE_DIR)
.terraform/providers-cache/

# .tfstate files (contains live infrastructure state and sensitive data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (likely contain sensitive passwords/secrets)
*.tfvars
*.tfvars.json

# Ignore override files as they may contain local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include dependency lockfile (crucial for reproducible provider versions)
!.terraform.lock.hcl

# Terraform CLI configuration
.terraform.rc
terraform.rc

# Saved plans (`tofu plan -out=...`) and their JSON renderings hold every planned
# attribute in clear text, sensitive ones included (k3s_token in the cloud-init snippet)
*tfplan*


# ==============================================================================
# Kubernetes / Cluster Secret Ignore Patterns
# ==============================================================================
kubeconfig.yaml
# mktemp files of the kubeconfig fetch (modules/k3s-kubeconfig), left behind if it is killed
kubeconfig.yaml.*
kubeconfig
kubeconfig.backup
*.kubeconfig
secrets.yaml
*.secret


# ==============================================================================
# OS & System-Specific Files
# ==============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini


# ==============================================================================
# Logs and Run Output
# ==============================================================================
*.log
diagnostics.log

# Python bytecode caches (image test helpers)
__pycache__/
*.pyc

# ==============================================================================
# SOPS / Age Encryption Keys
# ==============================================================================
# NEVER commit the private age key — only the public key belongs in .sops.yaml.
# Keys belong outside the repository (docs/SOPS.md §2); these patterns only catch
# a key that ends up here anyway: key.txt, key.new.txt, keys.txt, age.agekey.
key*.txt
*.agekey
*.age-key
*.key
