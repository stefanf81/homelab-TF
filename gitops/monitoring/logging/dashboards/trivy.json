{
  "uid": "trivy-operator",
  "title": "Trivy Operator",
  "description": "Trivy vulnerability, misconfiguration, RBAC, exposed secret, compliance, and operator health metrics. Based on Aqua's Grafana dashboard 17813.",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {
          "text": "VictoriaMetrics",
          "value": "VictoriaMetrics"
        },
        "hide": 2,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(trivy_image_vulnerabilities, namespace)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Security Issues by Type",
      "description": "Exported vulnerability, configuration, RBAC and secret findings. Infrastructure metric coverage is shown separately below; absent metrics are not converted to zero findings. RBAC includes cluster-role findings, which have no namespace and are counted whatever namespaces are selected.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(trivy_image_vulnerabilities{namespace=~\"$namespace\"})",
          "instant": true,
          "legendFormat": "Vulnerabilities",
          "refId": "A"
        },
        {
          "expr": "sum(trivy_resource_configaudits{namespace=~\"$namespace\"})",
          "instant": true,
          "legendFormat": "Misconfiguration",
          "refId": "B"
        },
        {
          "expr": "sum(trivy_role_rbacassessments{namespace=~\"$namespace\"} or trivy_clusterrole_clusterrbacassessments)",
          "instant": true,
          "legendFormat": "RBAC",
          "refId": "C"
        },
        {
          "expr": "sum(trivy_image_exposedsecrets{namespace=~\"$namespace\"})",
          "instant": true,
          "legendFormat": "Exposed Secrets",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Vulnerabilities by Severity",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (severity) (trivy_image_vulnerabilities{namespace=~\"$namespace\"})",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Vulnerabilities found in scanned container images, by severity, for the selected namespaces."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Vulnerabilities by Namespace (top 15)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "topk_max(15, sum by (namespace) (trivy_image_vulnerabilities{namespace=~\"$namespace\"}))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "The 15 namespaces with the highest peak in the selected range (MetricsQL topk_max, so the set does not change from point to point); compare with the totals panel for full coverage."
    },
    {
      "id": 4,
      "type": "table",
      "title": "Vulnerabilities by Image",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "max by (image_registry, image_repository, image_tag, namespace, severity) (trivy_image_vulnerabilities{namespace=~\"$namespace\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "image_registry": "Registry",
              "image_repository": "Image",
              "image_tag": "Tag",
              "namespace": "Namespace",
              "severity": "Severity",
              "Value": "Findings"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "frameIndex": 0
      },
      "description": "Vulnerability counts per image, tag, namespace and severity. Trivy writes one report per workload container; an image used by several workloads is counted once."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Misconfiguration by Severity",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (severity) (trivy_resource_configaudits{namespace=~\"$namespace\"})",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Kubernetes resource misconfigurations (config audits) by severity."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Misconfiguration by Namespace (top 15)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "topk_max(15, sum by (namespace) (trivy_resource_configaudits{namespace=~\"$namespace\"}))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "The 15 namespaces with the highest peak in the selected range (MetricsQL topk_max, so the set does not change from point to point); compare with the totals panel for full coverage."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RBAC Findings by Severity",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (severity) (trivy_role_rbacassessments{namespace=~\"$namespace\"} or trivy_clusterrole_clusterrbacassessments)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "RBAC findings for roles and cluster roles by severity. Cluster-role findings have no namespace and are included whatever namespaces are selected."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Exposed Secrets by Namespace",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "topk_max(15, sum by (namespace) (trivy_image_exposedsecrets{namespace=~\"$namespace\"}))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Secrets found exposed in container images: the 15 namespaces with the highest peak in the selected range."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Compliance Failing Checks",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum by (title) (trivy_cluster_compliance{status=\"Fail\"})",
          "legendFormat": "{{title}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Failing controls per compliance framework (the legend is the framework title, e.g. nsa). Per-control detail is in the ClusterComplianceReports."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Compliance Passing Checks",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum by (title) (trivy_cluster_compliance{status=\"Pass\"})",
          "legendFormat": "{{title}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Passing controls per compliance framework (the legend is the framework title, e.g. nsa). Per-control detail is in the ClusterComplianceReports."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Controller Reconcile Errors",
      "description": "Reconcile errors in the selected time range (a lifetime counter would stay red until the operator restarts).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "sum(increase(controller_runtime_reconcile_errors_total{job=~\".*trivy.*\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Reconciliations by Controller",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 48
      },
      "targets": [
        {
          "expr": "sum by (controller, result) (rate(controller_runtime_reconcile_total{job=~\".*trivy.*\"}[5m]))",
          "legendFormat": "{{controller}} / {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Trivy operator reconcile runs per second by controller and result. Errors mean scans are not completing."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Infrastructure metric coverage",
      "description": "Whether namespaced infrastructure finding metrics exist for the selected namespaces while the Trivy scrape is healthy. This reports telemetry coverage, not the number of findings or scan freshness. An unavailable scrape returns no data.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 56
      },
      "targets": [
        {
          "expr": "((count(trivy_resource_infraassessments{namespace=~\"$namespace\"}) > bool 0) or vector(0)) and on() (min(up{job=\"trivy-operator\"}) == 1)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not exported",
                  "color": "gray"
                },
                "1": {
                  "text": "Available",
                  "color": "blue"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 14,
      "type": "text",
      "title": "Infrastructure report coverage",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 56
      },
      "options": {
        "mode": "markdown",
        "content": "The installed Trivy Operator v0.35.0 findings collector reads **namespaced InfraAssessmentReports** for `trivy_resource_infraassessments`; it does not export **ClusterInfraAssessmentReports** such as `node-ubuntu`. A missing metric is therefore not proof of zero infrastructure findings.\n\nInspect node reports and scan currency with `kubectl get clusterinfraassessmentreports -o yaml`; use the compliance panels above for exported cluster compliance summaries. **Not exported** means no namespaced metric series for this selection; it does not certify node health."
      }
    }
  ],
  "graphTooltip": 1,
  "tags": [
    "trivy",
    "security",
    "vulnerabilities",
    "homelab"
  ],
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "dashboard"
    }
  ]
}
