              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Sampled user agents in blocked groups (Cloudflare)",
      "description": "Each client/rule/host/minute group retains its first user agent and attributes the group's count to that sample. This is not an exact per-user-agent request ranking. Shows at most the top 20 sampled values.",
