    },
    {
      "id": 13,
      "type": "logs",
      "title": "Recent Cloudflare blocks",
      "description": "Raw aggregated Security Events (per client IP, rule source, minute). Shows the most recent matching records up to the Loki datasource line limit (1,000 by default); the stat and time-series panels above count the events collected into Loki.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"cloudflare-firewall\"} | json | line_format `{{.action}} {{.source}} ip={{.client_ip}} host={{.host}} path={{.path}} ua={{.user_agent}} hits={{.count}}`"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLines": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true
