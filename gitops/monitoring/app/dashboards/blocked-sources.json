{
  "uid": "blocked-sources",
  "title": "Blocked Sources",
  "description": "Per-IP traffic rejected by Cloudflare (proxied path) and Cilium (direct path). Client IPs are parsed from logs at query time, never metric labels.",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cloudflare blocked requests",
      "description": "Sum of blocked requests reported by Cloudflare Security Events in the selected range. The collector writes only when there are events, so 0 means no blocks only while \"Cloudflare collector age\" (next to this tile) is green.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({job=\"cloudflare-firewall\"} | json | unwrap count | __error__=\"\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cloudflare collector age",
      "description": "Time since the last successful Security Events collection. Requires Zone Analytics: Read on the API token.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - cloudflare_firewall_last_success_timestamp_seconds",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cloudflare collector errors",
      "description": "Failed Security Events collections in the range, by reason.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(cloudflare_firewall_collector_errors_total[$__range])) or on() vector(0)",
          "legendFormat": "{{reason}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cilium Gateway dropped flows",
      "description": "Non-reply DROPPED flows involving reserved:ingress (identity 8), with POLICY_DENIED or no recorded reason. Reasonless flows are not proof of an AbuseIPDB or L7-policy block. These are flow events, not unique HTTP requests. Shows 0 while the Hubble export delivers any flow in the range, and No data when it delivers none (export or Alloy tail down, or a completely quiet gateway).",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"hubble-flows\"} | json | __error__=\"\" | flow_verdict=\"DROPPED\" | flow_is_reply!=\"true\" | (flow_source_identity=\"8\" or flow_destination_identity=\"8\") | (flow_drop_reason_desc=\"POLICY_DENIED\" or flow_drop_reason_desc=\"\") [$__range])) or (0 * sum(count_over_time({job=\"hubble-flows\"}[$__range])))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cloudflare blocks over time",
      "description": "Blocked requests per displayed interval (minimum 1 minute; wider for long time ranges), split by Cloudflare rule source. firewallCustom includes custom rules generally; inspect rule_id to identify the managed AbuseIPDB rule. Bars represent counts per interval; missing intervals are not connected or assumed to be zero.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (sum_over_time({job=\"cloudflare-firewall\"} | json | unwrap count | __error__=\"\" [$__interval]))",
          "legendFormat": "{{source}}"
        }
      ],
      "interval": "1m",
      "maxDataPoints": 300,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cilium Gateway dropped flows over time",
      "description": "Non-reply dropped flows per displayed interval (minimum 1 minute) involving reserved:ingress (identity 8). POLICY_DENIED confirms policy enforcement, but not which policy; reasonless drops remain unattributed. Source or destination may be the ingress identity because Envoy emits both ingress and egress events. Bars represent counts per interval; missing intervals are not connected or assumed to be zero.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"hubble-flows\"} | json | __error__=\"\" | flow_verdict=\"DROPPED\" | flow_is_reply!=\"true\" | (flow_source_identity=\"8\" or flow_destination_identity=\"8\") | flow_drop_reason_desc=\"POLICY_DENIED\" [$__interval]))",
          "legendFormat": "POLICY_DENIED"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({job=\"hubble-flows\"} | json | __error__=\"\" | flow_verdict=\"DROPPED\" | flow_is_reply!=\"true\" | (flow_source_identity=\"8\" or flow_destination_identity=\"8\") | flow_drop_reason_desc=\"\" [$__interval]))",
          "legendFormat": "Gateway drop (reason not recorded)"
        }
      ],
      "interval": "1m",
      "maxDataPoints": 300,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top blocked client IPs (Cloudflare)",
      "description": "Client IPs blocked at the Cloudflare edge, parsed from the Security Events log body. Shows at most the top 20 entries; ties can hide the remaining values.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (client_ip) (sum_over_time({job=\"cloudflare-firewall\"} | json | unwrap count | __error__=\"\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "client_ip": 0,
              "Value": 1
            },
            "renameByName": {
              "client_ip": "Client IP",
              "Value": "Blocked requests"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Blocked requests",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Blocked requests"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "client_ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Look up on AbuseIPDB",
                    "url": "https://www.abuseipdb.com/check/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top dropped source IPs (Cilium Gateway)",
      "description": "Source IPs from the same Gateway drop filter as the overview. For proxied traffic this can be a Cloudflare edge address; reasonless drops are not attributed to a particular policy. Shows at most the top 20 entries; ties can hide the remaining values.",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (flow_IP_source) (count_over_time({job=\"hubble-flows\"} | json | __error__=\"\" | flow_verdict=\"DROPPED\" | flow_is_reply!=\"true\" | (flow_source_identity=\"8\" or flow_destination_identity=\"8\") | (flow_drop_reason_desc=\"POLICY_DENIED\" or flow_drop_reason_desc=\"\") | flow_IP_source!=\"\" | flow_IP_source!=\"::\" | flow_IP_source!~\"fe80:.*\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "flow_IP_source": 0,
              "Value": 1
            },
            "renameByName": {
              "flow_IP_source": "Source IP",
              "Value": "Dropped flows"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Dropped flows",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Dropped flows"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "flow_IP_source"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Look up on AbuseIPDB",
                    "url": "https://www.abuseipdb.com/check/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top blocked countries (Cloudflare)",
      "description": " Shows at most the top 20 entries; ties can hide the remaining values.",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (country) (sum_over_time({job=\"cloudflare-firewall\"} | json | unwrap count | __error__=\"\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "country": 0,
              "Value": 1
            },
            "renameByName": {
              "country": "Country",
              "Value": "Blocked requests"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Blocked requests",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Blocked requests"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Sampled paths in blocked groups (Cloudflare)",
      "description": "Each client/rule/host/minute group retains its first path and attributes the group's count to that sample. This is not an exact per-path request ranking. Shows at most the top 20 sampled values.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (path) (sum_over_time({job=\"cloudflare-firewall\"} | json | path=~\".+\" | unwrap count | __error__=\"\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "path": 0,
              "Value": 1
            },
            "renameByName": {
              "path": "Path (sampled)",
              "Value": "Blocked requests"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Blocked requests",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Blocked requests"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Top dropped TCP ports (Cilium Gateway)",
      "description": " Shows at most the top 20 entries; ties can hide the remaining values.",
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (flow_l4_TCP_destination_port) (count_over_time({job=\"hubble-flows\"} | json | __error__=\"\" | flow_verdict=\"DROPPED\" | flow_is_reply!=\"true\" | (flow_source_identity=\"8\" or flow_destination_identity=\"8\") | (flow_drop_reason_desc=\"POLICY_DENIED\" or flow_drop_reason_desc=\"\") | flow_l4_TCP_destination_port=~\".+\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
