              "flow_l4_TCP_destination_port": 0,
              "Value": 1
            },
            "renameByName": {
              "flow_l4_TCP_destination_port": "Destination port",
              "Value": "Dropped flows"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
