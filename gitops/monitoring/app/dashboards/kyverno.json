{
  "id": null,
  "uid": "kyverno",
  "title": "Kyverno",
  "description": "Kyverno policy evaluation results, admission review latency, policy changes, controller health and resource use.",
  "tags": [
    "kyverno",
    "policy",
    "security",
    "homelab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "text": "VictoriaMetrics",
          "value": "VictoriaMetrics"
        },
        "regex": "",
        "hide": 2,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Metrics targets",
      "description": "1 while vmagent scrapes all Kyverno controller metrics endpoints (admission, background, cleanup, reports).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{namespace=\"kyverno\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active policy rules",
      "description": "Rules currently present in the cluster, including the autogen-* rules Kyverno generates for Pod controllers. The admission and background controllers both export this metric; each rule is counted once.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (policy_type, policy_name, rule_name) (kyverno_policy_rule_info_total == 1))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rules not ready",
      "description": "Policy rules whose policy is not ready, counted once although two controllers export them.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (policy_type, policy_name, rule_name) (kyverno_policy_rule_info_total{status_ready=\"false\"} == 1)) or (0 * count(kyverno_policy_rule_info_total))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Policy failures",
      "description": "Rule evaluations that failed or errored in the selected range, across admission requests (including Flux server-side dry runs) and background scans. Counters are created at their first event and every Kyverno restart starts new series, so a series born inside the range is counted from zero (increase_pure) while a series that already existed before the range uses increase(); a scrape gap therefore does not inflate the counts.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((increase_pure(kyverno_policy_results_total{rule_result=~\"fail|error\"}[$__range]) unless last_over_time(kyverno_policy_results_total{rule_result=~\"fail|error\"}[1h] offset $__range)) or increase(kyverno_policy_results_total{rule_result=~\"fail|error\"}[$__range])) or (0 * sum(increase_pure(kyverno_policy_results_total[$__range])))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Requests denied",
      "description": "Admission requests Kyverno rejected in the selected range. A denial means a policy is doing its job. Counters are created at their first event and every Kyverno restart starts new series, so a series born inside the range is counted from zero (increase_pure) while a series that already existed before the range uses increase(); a scrape gap therefore does not inflate the counts.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((increase_pure(kyverno_admission_requests_total{request_allowed=\"false\"}[$__range]) unless last_over_time(kyverno_admission_requests_total{request_allowed=\"false\"}[1h] offset $__range)) or increase(kyverno_admission_requests_total{request_allowed=\"false\"}[$__range])) or (0 * sum(increase_pure(kyverno_admission_requests_total[$__range])))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Admission review p95",
      "description": "95th percentile of the time Kyverno takes to answer an admission webhook call over the selected range. Audit-mode policies without emitWarning run after the response and are excluded. Kyverno webhooks typically time out at 10 s. The smallest histogram bucket is 5 ms, so a value below 5 ms only means \"under 5 ms\".",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kyverno_admission_review_duration_seconds_bucket[$__range])))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Policy results",
      "description": "Rule evaluation results per displayed interval (minimum 5 minutes), including Flux server-side dry runs. Counters are created at their first event and every Kyverno restart starts new series, so a series born inside the range is counted from zero (increase_pure) while a series that already existed before the range uses increase(); a scrape gap therefore does not inflate the counts.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule_result) ((increase_pure(kyverno_policy_results_total[$__interval]) unless last_over_time(kyverno_policy_results_total[1h] offset $__interval)) or increase(kyverno_policy_results_total[$__interval]))",
          "legendFormat": "{{rule_result}}"
        }
      ],
      "interval": "5m",
      "maxDataPoints": 300,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pass"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fail"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "skip"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Admission requests",
      "description": "Admission requests per displayed interval (minimum 5 minutes), by whether Kyverno allowed them. Counters are created at their first event and every Kyverno restart starts new series, so a series born inside the range is counted from zero (increase_pure) while a series that already existed before the range uses increase(); a scrape gap therefore does not inflate the counts.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (request_allowed) ((increase_pure(kyverno_admission_requests_total[$__interval]) unless last_over_time(kyverno_admission_requests_total[1h] offset $__interval)) or increase(kyverno_admission_requests_total[$__interval]))",
          "legendFormat": "allowed={{request_allowed}}"
        }
      ],
      "interval": "5m",
      "maxDataPoints": 300,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "allowed=true"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "allowed=false"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Admission review latency",
      "description": "Time Kyverno takes to answer the API server's admission webhook calls: request handling plus mutate, Enforce-mode validate, image-verify and emitWarning Audit rules; Kyverno's checks on its own policy objects are counted here too. Other Audit-mode policies, which covers both current ClusterPolicies, are evaluated after the response is sent and are not included; their rule time is in Policy execution latency. Quantiles below 5 ms are interpolated inside the smallest histogram bucket (0-5 ms), so a flat 2.5 / 4.75 / 4.95 ms means \"under 5 ms\", not a measured value.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kyverno_admission_review_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kyverno_admission_review_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kyverno_admission_review_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Policy execution latency (p95, slowest policies)",
      "description": "95th percentile rule execution time for the eight policies with the highest peak in the selected range (MetricsQL topk_max, so the set does not change from point to point). The smallest histogram bucket is 5 ms and simple pattern rules finish below it, so a flat 4.75 ms line means \"under 5 ms\", not a measured value.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk_max(8, histogram_quantile(0.95, sum by (le, policy_name) (rate(kyverno_policy_execution_duration_seconds_bucket[$__rate_interval]))))",
          "legendFormat": "{{policy_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Failing rules in the selected range",
      "description": "Policy rules with failed or errored evaluations, most first (top 25); includes Flux server-side dry runs. Counters are created at their first event and every Kyverno restart starts new series, so a series born inside the range is counted from zero (increase_pure) while a series that already existed before the range uses increase(); a scrape gap therefore does not inflate the counts.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(25, sum by (policy_name, rule_name, resource_kind, rule_type) ((increase_pure(kyverno_policy_results_total{rule_result=~\"fail|error\"}[$__range]) unless last_over_time(kyverno_policy_results_total{rule_result=~\"fail|error\"}[1h] offset $__range)) or increase(kyverno_policy_results_total{rule_result=~\"fail|error\"}[$__range])) > 0)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "policy_name": 0,
              "rule_name": 1,
              "resource_kind": 2,
              "rule_type": 3,
              "Value": 4
            },
            "renameByName": {
              "policy_name": "Policy",
              "rule_name": "Rule",
              "resource_kind": "Kind",
              "rule_type": "Type",
              "Value": "Failures"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Failures",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No failures"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failures"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Policy changes",
      "description": "Policy creations, updates and deletions per displayed interval (minimum 5 minutes), as seen by the admission controller (the background controller records the same changes). A controller restart re-lists every policy, which can show up as \"created\".",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (policy_change_type) (increase(kyverno_policy_changes_total{job=\"admission-controller\"}[$__interval]))",
          "legendFormat": "{{policy_change_type}}"
        }
      ],
      "interval": "5m",
      "maxDataPoints": 300,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Controller reconciles",
      "description": "Reconciliations per second by Kyverno controller.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (controller_name) (rate(kyverno_controller_reconcile_total[$__rate_interval]))",
          "legendFormat": "{{controller_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Requeues and queue drops",
      "description": "Reconciliation errors that were requeued, and work dropped from the queue after the retry limit, per displayed interval (minimum 5 minutes). One failing object can add up to 10 requeues before it is dropped. Both counters are created at their first event, so a quiet cluster shows empty bars. Counters are created at their first event and every Kyverno restart starts new series, so a series born inside the range is counted from zero (increase_pure) while a series that already existed before the range uses increase(); a scrape gap therefore does not inflate the counts.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (controller_name) ((increase_pure(kyverno_controller_requeue_total[$__interval]) unless last_over_time(kyverno_controller_requeue_total[1h] offset $__interval)) or increase(kyverno_controller_requeue_total[$__interval]))",
          "legendFormat": "requeue {{controller_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (controller_name) ((increase_pure(kyverno_controller_drop_total[$__interval]) unless last_over_time(kyverno_controller_drop_total[1h] offset $__interval)) or increase(kyverno_controller_drop_total[$__interval]))",
          "legendFormat": "drop {{controller_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m",
      "maxDataPoints": 300
    },
    {
