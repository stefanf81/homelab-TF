{
  "uid": "abuseipdb-security",
  "title": "AbuseIPDB Security",
  "description": "Feed health, change tracking and Cilium enforcement for the runtime-managed AbuseIPDB denylist. Detailed per-IP investigation is done in Loki / Hubble, not as metric labels. Per-IP block detail lives on the Blocked Sources dashboard.",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 25,
      "type": "stat",
      "title": "Synchronizer scrape",
      "description": "1 while vmagent successfully scrapes the abuseipdb-sync metrics endpoint. DOWN or No data means every other tile on this dashboard is stale or empty.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"abuseipdb-sync\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Feed entries",
      "description": "CIDRs currently published in CiliumCIDRGroup/abuseipdb.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abuseipdb_entries",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Feed age",
      "description": "Time since the CiliumCIDRGroup denylist was last updated successfully, as tracked by the synchronizer (restored from the group annotation after restarts, refreshed every minute). Orange beyond 7h (missed 6h cycle), red beyond ABUSEIPDB_MAX_STALE_AGE (24h). No data: no successful update recorded yet (exporter 0.3.1 exports 0 until then and after a restart until the first refresh; the tile hides that 0). Cloudflare edge freshness is shown separately below.",
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abuseipdb_feed_age_seconds and on(instance) ((abuseipdb_last_success_timestamp_seconds > 0) or (abuseipdb_feed_age_seconds > 0))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 25200
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last successful sync",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(abuseipdb_last_success_timestamp_seconds > 0) * 1000",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "When the CiliumCIDRGroup denylist was last updated successfully (exporter 0.3.2 and later: tracks the Cilium sink and is restored after restarts). An old value means the synchronizer is failing; Cloudflare edge freshness is shown separately below. No data: no successful update recorded yet. Exporter 0.3.1 sets this only when every sink succeeded and does not restore it after a restart, so it stays empty until the next fully successful sync; Feed age next to it is correct on both versions."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sync status",
      "description": "Result of the most recent synchronization attempt.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abuseipdb_sync_success",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILING",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Last API status",
      "description": "HTTP status of the last AbuseIPDB blacklist request (after retries). 200: AbuseIPDB answered, but the sync can still fail afterwards: a body that is empty, HTML/JSON, not text/plain or cut off while reading counts as a download error, and parse, validation and Kubernetes failures also leave 200 here; check Sync status and Sync errors by reason. 429 daily rate limit, 401/422 configuration problem, 0 no HTTP response (connection or header timeout, or no request since the synchronizer started).",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abuseipdb_last_http_status",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No HTTP response",
                  "color": "orange"
                },
                "200": {
                  "text": "200 OK",
                  "color": "green"
                },
                "401": {
                  "text": "401 Unauthorized",
                  "color": "red"
                },
                "422": {
                  "text": "422 Invalid request",
                  "color": "red"
                },
                "429": {
                  "text": "429 Rate limited",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Invalid feed lines",
      "description": "Lines rejected as malformed in the selected time range. Any increase means a response failed validation and was not applied. A restarted synchronizer starts a new counter and syncs before its first scrape, so a new pod's series is counted from zero (increase_pure); series that already existed before the range use increase().",
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((increase_pure(abuseipdb_invalid_entries_total[$__range]) unless last_over_time(abuseipdb_invalid_entries_total[1h] offset $__range)) or increase(abuseipdb_invalid_entries_total[$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sync errors by reason",
      "description": "Failed synchronization attempts per displayed interval (minimum 5 minutes) by bounded reason: download (any failed feed request, including HTTP 429 rate limiting; see Last API status), parse, validation or kube.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(abuseipdb_sync_errors_total[$__interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "5m",
      "maxDataPoints": 300
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Entries added / removed",
      "description": "Change applied during the last successful synchronization.",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abuseipdb_entries_added",
          "legendFormat": "added"
        },
        {
          "refId": "B",
          "expr": "abuseipdb_entries_removed",
          "legendFormat": "removed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Filtered feed entries",
      "description": "Feed entries removed before applying: trusted exceptions and protected/internal ranges.",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abuseipdb_exceptions_removed",
          "legendFormat": "exceptions"
        },
        {
          "refId": "B",
          "expr": "abuseipdb_protected_removed",
          "legendFormat": "protected ranges"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cilium drops by reason",
      "description": "Hubble drop metric for every drop reason, not only policy denials. The AbuseIPDB deny selects reserved:ingress, which has no BPF policy map: only Envoy enforces it, so its hits can only appear as DROP_REASON_UNKNOWN, together with every other Envoy/L7 denial (they cannot be attributed to AbuseIPDB from this metric). POLICY_DENIED is a BPF default-deny drop (no allow rule matched) and POLICY_DENY a BPF deny rule on a pod endpoint; the AbuseIPDB deny produces neither. Aggregate, bounded labels; per-IP detail is on Blocked Sources.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(hubble_drop_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Gateway 403 responses",
      "description": "HTTP responses with status 403 counted by Hubble's httpV2 metric for L7-visible traffic, including 403s returned by backends or the WAF. Whether Envoy policy denials at reserved:ingress (the AbuseIPDB direct-path deny) are counted here is not verified; the Blocked Sources dashboard shows those drops.",
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hubble_http_requests_total{status=\"403\"}[$__rate_interval]))",
          "legendFormat": "403/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Drops by protocol",
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol) (rate(hubble_drop_total[$__rate_interval]))",
          "legendFormat": "{{protocol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Packets dropped by Cilium per second by protocol, for all drop reasons, not only the AbuseIPDB denylist."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Cilium scrape targets",
      "description": "Scrape result per job (cilium-agent, cilium-operator, hubble): DOWN if any target of that job fails. A missing tile means the job has no scrape target.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (job) (up{job=~\"cilium-agent|cilium-operator|hubble\"})",
          "instant": true,
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Failing Cilium controllers",
      "gridPos": {
        "x": 6,
        "y": 23,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(cilium_controllers_failing)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Cilium controllers currently failing on any node. Normally 0."
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Max BPF map pressure",
      "description": "Highest BPF map utilization across agents. Watch after large feed updates (see the scalability notes in the runbook).",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(cilium_bpf_map_pressure)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Policy enforcement status",
      "description": "Endpoints by enforcement mode. A drop in enforced endpoints can indicate policy propagation problems.",
      "gridPos": {
        "x": 18,
        "y": 23,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (enforcement) (cilium_policy_endpoint_enforcement_status)",
          "legendFormat": "{{enforcement}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Cloudflare sync status",
      "description": "Result of the most recent push to the Cloudflare edge (IP list + WAF rule). No attempt: no push has been attempted since the synchronizer started (each push follows a successful feed download, none after an AbuseIPDB 429). FAILING appears only after a push failed in this process, so a restart does not paint the tile red (exporter 0.3.1 exports 0 until the first push; the tile hides that 0).",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
