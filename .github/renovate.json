{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "enabledManagers": ["custom.regex", "dockerfile", "flux", "kubernetes"],
  "ignorePaths": [
    "gitops/clusters/taskflow/flux-system/gotk-components.yaml",
    "gitops/infrastructure/controllers/gateway-api/**",
    "**/*-secrets.yaml"
  ],
  "flux": {
    "managerFilePatterns": [
      "/^gitops\\/infrastructure\\/controllers\\/.+\\.ya?ml$/",
      "/^gitops\\/monitoring\\/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^gitops\\/apps\\/.+\\.ya?ml$/",
      "/^gitops\\/infrastructure\\/controllers\\/renovate\\/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^gitops\\/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+(?:tag|version):\\s*[\"']?(?<currentValue>[^\"'\\s#]+)[\"']?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Flux owns these mutable-tag digest pins.",
      "matchManagers": ["kubernetes"],
      "matchPackageNames": [
        "ghcr.io/stefanf81/taskflow-backend",
        "ghcr.io/stefanf81/taskflow-frontend"
      ],
      "enabled": false
    },
    {
      "description": "Flux system manifests are generated and must be regenerated as a unit.",
      "matchManagers": ["flux"],
      "matchPackageNames": ["fluxcd/flux2"],
      "enabled": false
    },
    {
      "description": "This setup manages image tags and Helm charts, not Kubernetes API migrations.",
      "matchDatasources": ["kubernetes-api"],
      "enabled": false
    },
    {
      "description": "Require dashboard checkbox approval for all major updates to prevent breaking changes.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Group general patch updates together",
      "matchUpdateTypes": ["patch"],
      "groupName": "patch updates"
    },
    {
      "description": "Group VictoriaMetrics stack components together",
      "matchPackageNames": [
        "victoria-metrics-k8s-stack",
        "victoriametrics/operator",
        "grafana/grafana"
      ],
      "groupName": "VictoriaMetrics Stack"
    },
    {
      "description": "Group Falco components together",
      "matchPackageNames": [
        "falco",
        "falcosecurity/falcosidekick"
      ],
      "groupName": "Falco Stack"
    },
    {
      "description": "Group Logging components together",
      "matchPackageNames": [
        "loki",
        "alloy"
      ],
      "groupName": "Logging Stack"
    },
    {
      "description": "Group Proxmox CSI components together",
      "matchPackageNames": [
        "proxmox-csi-plugin",
        "ghcr.io/sergelogvinov/proxmox-csi-controller"
      ],
      "groupName": "Proxmox CSI"
    },
    {
      "description": "Group Metrics Server chart and controller image together",
      "matchPackageNames": [
        "metrics-server",
        "registry.k8s.io/metrics-server/metrics-server"
      ],
      "groupName": "Metrics Server"
    },
    {
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "labels": ["dependencies", "helm"]
    },
    {
      "matchManagers": ["custom.regex", "dockerfile", "kubernetes"],
      "labels": ["container-image", "dependencies"]
    },
    {
      "matchPackageNames": ["renovate/renovate"],
      "labels": ["dependencies", "renovate"]
    }
  ]
}
