{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "enabledManagers": ["custom.regex", "dockerfile", "flux", "github-actions", "gomod", "kubernetes", "mise", "terraform"],
  "ignorePaths": [
    "gitops/infrastructure/controllers/gateway-api/standard-install.yaml",
    "**/*-secrets.yaml"
  ],
  "flux": {
    "managerFilePatterns": [
      "/^gitops\\/infrastructure\\/controllers\\/.+\\.ya?ml$/",
      "/^gitops\\/infrastructure\\/flux-instance\\/.+\\.ya?ml$/",
      "/^gitops\\/platform\\/.+\\.ya?ml$/",
      "/^gitops\\/monitoring\\/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^gitops\\/apps\\/.+\\.ya?ml$/",
      "/^gitops\\/platform\\/abuseipdb\\/.+\\.ya?ml$/",
      "/^gitops\\/platform\\/renovate\\/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^gitops\\/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+(?:#\\s*)?(?:tag|version|bundle-version):\\s*[\"']?(?<currentValue>[^\"'\\s#]+)[\"']?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Flux owns these mutable-tag digest pins.",
      "matchManagers": ["kubernetes"],
      "matchPackageNames": [
        "ghcr.io/stefanf81/taskflow-backend",
        "ghcr.io/stefanf81/taskflow-frontend"
      ],
      "enabled": false
    },
    {
      "description": "This setup manages image tags and Helm charts, not Kubernetes API migrations.",
      "matchDatasources": ["kubernetes-api"],
      "enabled": false
    },
    {
      "description": "Require dashboard checkbox approval for all major updates to prevent breaking changes.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Hold the Gateway API CRDs at the version Cilium is built and conformance-tested against (Cilium 1.20 = v1.6.3: sigs.k8s.io/gateway-api in its go.mod, gateway_api_version in Documentation/conf.py). Raise this bound when the Cilium release in use moves to v1.7. Note: v1.7.0's safe-upgrades policy rejects CRDs older than v1.7.0, so that upgrade cannot simply be rolled back.",
      "matchPackageNames": ["kubernetes-sigs/gateway-api"],
      "allowedVersions": "<1.7.0"
    },
    {
      "description": "Group general patch updates together",
      "matchUpdateTypes": ["patch"],
      "groupName": "patch updates"
    },
    {
      "description": "Automerge digest-only and patch updates once their CI checks pass (Flux then rolls them out). Minor and major updates stay manual.",
      "matchUpdateTypes": ["digest", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": "Group VictoriaMetrics stack components together",
      "matchPackageNames": [
        "victoria-metrics-k8s-stack",
        "victoriametrics/operator",
        "grafana/grafana"
      ],
      "groupName": "VictoriaMetrics Stack"
    },
    {
      "description": "Group Falco components together",
      "matchPackageNames": [
        "falco",
        "ghcr.io/falcosecurity/charts/falco",
        "falcosecurity/falcosidekick"
      ],
      "groupName": "Falco Stack"
    },
    {
      "description": "Group Logging components together",
      "matchPackageNames": [
        "loki",
        "alloy"
      ],
      "groupName": "Logging Stack"
    },
    {
      "description": "Group Proxmox CSI components together",
      "matchPackageNames": [
        "proxmox-csi-plugin",
        "ghcr.io/sergelogvinov/charts/proxmox-csi-plugin",
        "ghcr.io/sergelogvinov/proxmox-csi-controller"
      ],
      "groupName": "Proxmox CSI"
    },
    {
      "description": "Group Metrics Server chart and controller image together",
      "matchPackageNames": [
        "metrics-server",
        "registry.k8s.io/metrics-server/metrics-server"
      ],
      "groupName": "Metrics Server"
    },
    {
      "description": "Helm charts: HTTP HelmRepository (helm) and OCIRepository (docker) sources.",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm", "docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "labels": ["dependencies", "helm"]
    },
    {
      "matchManagers": ["custom.regex", "dockerfile", "kubernetes"],
      "labels": ["container-image", "dependencies"]
    },
    {
      "matchPackageNames": ["renovate/renovate"],
      "labels": ["dependencies", "renovate"]
    },
    {
      "description": "flux2 and kubectl in mise.toml follow the cluster's Flux and k3s minors (scripts/check-tool-versions.sh); only patch updates are automatic.",
      "matchManagers": ["mise"],
      "matchDepNames": ["flux2", "kubectl"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    }
  ]
}
